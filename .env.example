# ─── YouTube ───────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# ─── AI 분석 ────────────────────────────────────────────────
# AI 제공자 선택: claude | gemini
AI_PROVIDER=claude

# Claude (기본값, 권장)
CLAUDE_API_KEY=your_anthropic_api_key

# Gemini (선택적 대안, 무료 티어 있음)
# GEMINI_API_KEY=your_gemini_api_key
# AI_PROVIDER=gemini

# ─── 카카오톡 ───────────────────────────────────────────────
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret  # 카카오 로그인 > 보안에서 확인
KAKAO_REDIRECT_URI=http://localhost:5000/callback
# 최초 인증 후 자동 발급·갱신됨
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=

# ─── GitHub Pages (선택) ────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=username/meme-trend-archive
GITHUB_BRANCH=gh-pages
